{
  "name": "trouve-ta-table",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=packages/ttt-api",
    "dev:web": "npm run dev --workspace=packages/ttt-web",
    "build": "npm run build --workspace=packages/ttt-api && npm run build --workspace=packages/ttt-web",

    "docker:dev": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v && docker system prune -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
