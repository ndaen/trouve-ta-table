# .env.docker.example
# Copiez ce fichier vers .env.docker et remplissez les valeurs

# ==========================================
# 📊 BASE DE DONNÉES
# ==========================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ==========================================
# 🔐 API CONFIGURATION
# ==========================================
# Générez une clé de 32 caractères : openssl rand -base64 32
APP_KEY=

# URL du frontend pour CORS et redirections
FRONTEND_URL=

# ==========================================
# 🌐 FRONTEND CONFIGURATION
# ==========================================
# URL de l'API depuis le navigateur
VITE_API_URL=

# ==========================================
# 📧 EMAIL (optionnel pour le moment)
# ==========================================
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=